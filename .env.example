# Global environment — loaded into EVERY service via `env_file: .env` in docker-compose.yml.
# Put only keys shared by multiple services here. Copy to .env and fill in real values.

NODE_ENV=development

# Port each container listens on internally
PORT=8000

# Port the api-gateway is published on, on your machine
GATEWAY_HOST_PORT=8000

# Internal service URLs (resolved by compose service name)
POLICY_SCHEME_SERVICE_URL=http://policy-scheme-service:8000
RAG_SERVICE_URL=http://rag-service:8000
FRONTEND_SERVICE_URL=http://frontend:8000

# OpenAI — shared by every service that calls OpenAI. Leave empty until you add your key.
OPENAI_API_KEY=

# OpenRouter — shared by every service that calls OpenRouter (rag-service embeddings). Leave empty until you add your key.
OPENROUTER_API_KEY=

# MinIO (object storage) — used by the minio container and mapped to policy-scheme-service's S3 credentials.
# Password must be at least 8 characters.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
