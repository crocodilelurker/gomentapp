# Global environment — loaded into EVERY service via `env_file: .env` in docker-compose.yml.
# Put only keys shared by multiple services here. Copy to .env and fill in real values.

NODE_ENV=development

# Port each container listens on internally
PORT=8000

# Port the api-gateway is published on, on your machine
GATEWAY_HOST_PORT=8000

# Internal service URLs (resolved by compose service name)
POLICY_SCHEME_SERVICE_URL=http://policy-scheme-service:8000
