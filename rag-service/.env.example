# rag-service environment — loaded after the global /.env, so values here win.
# Copy to rag-service/.env.

# Generation (Step 5) — OPENAI_API_KEY itself lives in the global /.env
OPENAI_MODEL=gpt-4o-mini

# Embedding model on OpenRouter (Steps 3 & 4) — OPENROUTER_API_KEY lives in the global /.env.
# Changing the model requires re-ingesting: vector sizes differ between models.
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Vector store (Step 3.3)
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION=policies

# Chunking (Step 2) — characters; overlap must be smaller than size
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval (Step 4.3) — default number of chunks sent to the LLM
RAG_TOP_K=4

# Summaries — documents longer than this (characters) are summarised in parts, then merged
SUMMARY_MAX_CHARS=60000
