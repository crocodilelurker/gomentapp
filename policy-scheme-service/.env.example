# policy-scheme-service environment — loaded after the global /.env, so values here win.
# Copy to policy-scheme-service/.env.
# S3 credentials are NOT set here: docker-compose maps MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# from the global /.env to S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.

# Object storage (S3-compatible; MinIO in docker-compose)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=policies
S3_FORCE_PATH_STYLE=true

# Metadata catalog (SQLite file inside the policy-catalog-data volume)
CATALOG_DB_PATH=/app/data/catalog.db

# Upload limit in bytes (10 MiB)
MAX_UPLOAD_BYTES=10485760

# How long to wait for rag-service to chunk + embed a document
RAG_REQUEST_TIMEOUT_MS=120000

# How long to wait for rag-service to summarise a document (long documents are summarised in parts)
RAG_SUMMARY_TIMEOUT_MS=300000

# Background jobs (indexing + summarising run after the upload returns)
# Jobs run at the same time; keep low for rate-limited free models
JOB_CONCURRENCY=1
# How often due retries are picked up (newly queued jobs start immediately)
JOB_POLL_INTERVAL_MS=2000
# Attempts per job before it is marked FAILED
JOB_MAX_ATTEMPTS=3
# Retry delay: 10s, then 20s, 40s, ...
JOB_RETRY_BASE_MS=10000
